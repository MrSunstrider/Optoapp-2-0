#!/usr/bin/env bash
# =============================================================================
# Pre-commit hook: Supabase migration lint
#
# Runs `supabase db lint` when staged files include paths under
# supabase/migrations/. Skips silently for non-migration changes.
# Exits gracefully (exit 0) if supabase CLI is not installed.
#
# Register with: git config core.hooksPath .githooks
# =============================================================================

set -euo pipefail

# --- Check if any staged files match supabase/migrations/ --------------------
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if ! echo "$staged_files" | grep -q "^supabase/migrations/"; then
    # No migration files staged — skip
    exit 0
fi

# --- Check Supabase CLI availability ----------------------------------------
if ! command -v supabase &>/dev/null; then
    echo "WARNING: supabase CLI not found — skipping migration lint." >&2
    echo "Install Supabase CLI: https://supabase.com/docs/guides/local-development/cli/getting-started" >&2
    exit 0
fi

# --- Check Docker availability ----------------------------------------------
if ! docker info &>/dev/null; then
    echo "WARNING: Docker not available — skipping migration lint." >&2
    echo "Start Docker Desktop or run lint in CI." >&2
    exit 0
fi

# --- Check if local Supabase is running -------------------------------------
if ! supabase status &>/dev/null; then
    echo "WARNING: local Supabase not running — skipping migration lint." >&2
    echo "Run 'supabase start' first or rely on CI validation." >&2
    exit 0
fi

# --- Run lint on staged migration files -------------------------------------
echo "Running supabase db lint on staged migration files..." >&2
supabase db lint

exit_code=$?
if [ "$exit_code" -ne 0 ]; then
    echo "ERROR: supabase db lint failed — commit aborted." >&2
    echo "Fix the migration file(s) before committing." >&2
    exit 1
fi
