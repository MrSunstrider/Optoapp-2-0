#!/usr/bin/env bash
# =============================================================================
# Pre-commit hook: Supabase migration lint + GGA code review
#
# 1. Runs `supabase db lint` when staged files include supabase/migrations/.
#    Skips gracefully when the Supabase CLI, Docker, or the local stack is
#    unavailable.
# 2. Runs Gentleman Guardian Angel (`gga run`) on every commit, using the
#    provider configured in .gga. Skips with a warning when gga is missing so
#    clones without the tool can still commit; CI remains the backstop.
#
# Register with: git config core.hooksPath .githooks
# =============================================================================

set -euo pipefail

run_migration_lint() {
    local staged_files
    staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

    if ! grep -q "^supabase/migrations/" <<<"$staged_files"; then
        return 0
    fi

    if ! command -v supabase &>/dev/null; then
        echo "WARNING: supabase CLI not found — skipping migration lint." >&2
        echo "Install Supabase CLI: https://supabase.com/docs/guides/local-development/cli/getting-started" >&2
        return 0
    fi

    if ! docker info &>/dev/null; then
        echo "WARNING: Docker not available — skipping migration lint." >&2
        echo "Start Docker Desktop or run lint in CI." >&2
        return 0
    fi

    if ! supabase status &>/dev/null; then
        echo "WARNING: local Supabase not running — skipping migration lint." >&2
        echo "Run 'supabase start' first or rely on CI validation." >&2
        return 0
    fi

    echo "Running supabase db lint on staged migration files..." >&2
    if ! supabase db lint; then
        echo "ERROR: supabase db lint failed — commit aborted." >&2
        echo "Fix the migration file(s) before committing." >&2
        return 1
    fi
}

run_gga_review() {
    local gga_cmd="${GGA_CMD:-gga}"

    if ! command -v "$gga_cmd" &>/dev/null; then
        echo "WARNING: GGA not found — skipping AI code review." >&2
        echo "Install: https://github.com/Gentleman-Programming/gentleman-guardian-angel" >&2
        return 0
    fi

    if ! "$gga_cmd" run; then
        echo "ERROR: GGA review failed — commit aborted." >&2
        echo "Resolve the GGA observations before committing." >&2
        return 1
    fi
}

run_migration_lint || exit 1
run_gga_review || exit 1

exit 0
