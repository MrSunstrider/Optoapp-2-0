# Texto normalizado (evita diffs por CRLF/LF en Git).
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.keystore binary
*.jar binary
*.apk binary
*.aab binary
*.so binary
*.dex binary
