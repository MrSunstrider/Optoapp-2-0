# Supabase — required (both server-side SSR and client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# PIN security — optional for dev, required for production
OPTOAPP_WEB_PIN_PEPPER=a-random-64-char-string-used-for-hmac-pin-hashing
OPTOAPP_WEB_PIN_DEV=123456
