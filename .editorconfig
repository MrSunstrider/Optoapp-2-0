# Evita archivos UTF-16 o mezclas de fin de linea que rompen README / reglas.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.{kt,kts}]
indent_style = space
indent_size = 4

[*.{xml,html}]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2

[.cursorrules]
charset = utf-8
