ítems") +            if (canEditReceive) { +                TextButton( +                    onClick = { +                        val cantidadById = items.associate { it.id to it.cantidad } +                        val minRecibidoById = items.associate { it.id to it.recibido } +                        val absolute = ReceiveQuantities.toAbsoluteMap( +                            receivedTextById, +                            cantidadById, +                            minRecibidoById, +                        ) +                        viewModel.receiveItems(oc.id, absolute) +                    }, +                    enabled = items.isNotEmpty() && receiveInputsEnabled, +                ) { +                    Text("Confirmar recepción")                  }              }          }, @@ -257,3 +342,35 @@ private fun OrdenCompraDetailDialog(          },      )  } + +@Composable +private fun OrdenCompraReceiveItemRow( +    item: OrdenCompraItem, +    receivedText: String, +    canEditReceive: Boolean, +    editorsEnabled: Boolean, +    onReceivedTextChange: (String) -> Unit, +) { +    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) { +        Text( +            text = item.monturaId, +            style = MaterialTheme.typography.bodyMedium, +            fontWeight = FontWeight.Medium, +        ) +        Text( +            text = "Pedido: ${item.cantidad} · Ya recibido: ${item.recibido}", +            style = MaterialTheme.typography.bodySmall, +            color = MaterialTheme.colorScheme.onSurfaceVariant, +        ) +        if (canEditReceive) { +            OptoTextField( +                value = receivedText, +                onValueChange = onReceivedTextChange, +                label = "Recibido total", +                keyboardType = KeyboardType.Number, +                enabled = editorsEnabled, +                modifier = Modifier.fillMaxWidth(), +            ) +        } +    } +}
diff --git a/optoapp/src/main/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantities.kt b/optoapp/src/main/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantities.kt new file mode 100644 index 00000000..9a15571d --- /dev/null +++ b/optoapp/src/main/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantities.kt @@ -0,0 +1,31 @@ +package com.example.optoapp.ui.screens.ordenescompra + +object ReceiveQuantities { + +    data class Line(val id: String, val cantidad: Int) + +    fun clamp(value: Int, cantidad: Int, minRecibido: Int = 0): Int { +        val max = cantidad.coerceAtLeast(0) +        val min = minRecibido.coerceIn(0, max) +        return value.coerceIn(min, max) +    } + +    fun fillPending(items: List<Line>): Map<String, Int> = +        items.associate { it.id to it.cantidad.coerceAtLeast(0) } + +    fun parseQuantity(raw: String, cantidad: Int, minRecibido: Int = 0): Int { +        val trimmed = raw.trim() +        if (trimmed.isEmpty()) return clamp(minRecibido, cantidad, minRecibido) +        val parsed = trimmed.toIntOrNull() ?: return clamp(minRecibido, cantidad, minRecibido) +        return clamp(parsed, cantidad, minRecibido) +    } + +    fun toAbsoluteMap( +        textById: Map<String, String>, +        cantidadById: Map<String, Int>, +        minRecibidoById: Map<String, Int> = emptyMap(), +    ): Map<String, Int> = +        cantidadById.mapValues { (id, cantidad) -> +            parseQuantity(textById[id].orEmpty(), cantidad, minRecibidoById[id] ?: 0) +        } +}
diff --git a/optoapp/src/test/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantitiesTest.kt b/optoapp/src/test/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantitiesTest.kt new file mode 100644 index 00000000..f691b131 --- /dev/null +++ b/optoapp/src/test/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantitiesTest.kt @@ -0,0 +1,122 @@ +package com.example.optoapp.ui.screens.ordenescompra + +import org.junit.Assert.assertEquals +import org.junit.Test + +class ReceiveQuantitiesTest { + +    @Test +    fun clamp_keepsValueInsideZeroToCantidad() { +        assertEquals(0, ReceiveQuantities.clamp(-3, 10)) +        assertEquals(0, ReceiveQuantities.clamp(0, 10)) +        assertEquals(4, ReceiveQuantities.clamp(4, 10)) +        assertEquals(10, ReceiveQuantities.clamp(10, 10)) +        assertEquals(10, ReceiveQuantities.clamp(15, 10)) +    } + +    @Test +    fun clamp_zeroCantidadAlwaysZero() { +        assertEquals(0, ReceiveQuantities.clamp(5, 0)) +        assertEquals(0, ReceiveQuantities.clamp(-1, 0)) +    } + +    @Test +    fun clamp_respectsMinRecibidoFloor() { +        assertEquals(3, ReceiveQuantities.clamp(0, 10, minRecibido = 3)) +        assertEquals(3, ReceiveQuantities.clamp(2, 10, minRecibido = 3)) +        assertEquals(5, ReceiveQuantities.clamp(5, 10, minRecibido = 3)) +        assertEquals(10, ReceiveQuantities.clamp(15, 10, minRecibido = 3)) +        assertEquals(10, ReceiveQuantities.clamp(0, 10, minRecibido = 15)) +    } + +    @Test +    fun fillPending_mapsEachIdToCantidad() { +        val items = listOf( +            ReceiveQuantities.Line("i1", 10), +            ReceiveQuantities.Line("i2", 5), +        ) +        assertEquals(mapOf("i1" to 10, "i2" to 5), ReceiveQuantities.fillPending(items)) +    } + +    @Test +    fun fillPending_emptyList_returnsEmptyMap() { +        assertEquals(emptyMap<String, Int>(), ReceiveQuantities.fillPending(emptyList())) +    } + +    @Test +    fun parseQuantity_parsesDigitsAndClamps() { +        assertEquals(4, ReceiveQuantities.parseQuantity("4", 10)) +        assertEquals(10, ReceiveQuantities.parseQuantity("99", 10)) +        assertEquals(0, ReceiveQuantities.parseQuantity("-2", 10)) +    } + +    @Test +    fun parseQuantity_blankOrInvalid_returnsZeroWhenNoPrior() { +        assertEquals(0, ReceiveQuantities.parseQuantity("", 10)) +        assertEquals(0, ReceiveQuantities.parseQuantity("   ", 10)) +        assertEquals(0, ReceiveQuantities.parseQuantity("abc", 10)) +        assertEquals(0, ReceiveQuantities.parseQuantity("1.5", 10)) +    } + +    @Test +    fun parseQuantity_blankOrInvalid_keepsPriorRecibido() { +        assertEquals(4, ReceiveQuantities.parseQuantity("", 10, minRecibido = 4)) +        assertEquals(4, ReceiveQuantities.parseQuantity("   ", 10, minRecibido = 4)) +        assertEquals(4, ReceiveQuantities.parseQuantity("abc", 10, minRecibido = 4)) +        assertEquals(4, ReceiveQuantities.parseQuantity("1.5", 10, minRecibido = 4)) +    } + +    @Test +    fun parseQuantity_parsesDigitsAndClampsToFloor() { +        assertEquals(4, ReceiveQuantities.parseQuantity("2", 10, minRecibido = 4)) +        assertEquals(7, ReceiveQuantities.parseQuantity("7", 10, minRecibido = 4)) +    } + +    @Test +    fun toAbsoluteMap_buildsClampedMapFromEditableText() { +        val textById = mapOf( +            "i1" to "4", +            "i2" to "", +            "i3" to "99", +        ) +        val cantidadById = mapOf( +            "i1" to 10, +            "i2" to 5, +            "i3" to 8, +        ) +        assertEquals( +            mapOf("i1" to 4, "i2" to 0, "i3" to 8), +            ReceiveQuantities.toAbsoluteMap(textById, cantidadById), +        ) +    } + +    @Test +    fun toAbsoluteMap_blankKeepsPriorAndRespectsFloor() { +        val textById = mapOf( +            "i1" to "4", +            "i2" to "", +            "i3" to "1", +        ) +        val cantidadById = mapOf( +            "i1" to 10, +            "i2" to 5, +            "i3" to 8, +        ) +        val minRecibidoById = mapOf( +            "i1" to 0, +            "i2" to 3, +            "i3" to 2, +        ) +        assertEquals( +            mapOf("i1" to 4, "i2" to 3, "i3" to 2), +            ReceiveQuantities.toAbsoluteMap(textById, cantidadById, minRecibidoById), +        ) +    } + +    @Test +    fun toAbsoluteMap_skipsIdsWithoutCantidad() { +        val textById = mapOf("i1" to "3", "ghost" to "9") +        val cantidadById = mapOf("i1" to 10) +        assertEquals(mapOf("i1" to 3), ReceiveQuantities.toAbsoluteMap(textById, cantidadById)) +    } +}
