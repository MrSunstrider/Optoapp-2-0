iState.first { it.success != null || it.error != null }          assertEquals("No se pudo registrar la recepción. Inténtalo de nuevo.", state.error)          assertNull(state.success) +        assertEquals("oc1", state.viewingId) +        assertFalse(state.receiving) +    } + +    @Test +    fun receiveItems_secondCallWhileInFlight_doesNotCallRepositoryTwice() = runTest { +        val gate = CompletableDeferred<Unit>() +        coEvery { repository.receiveItems(any(), any(), any()) } coAnswers { +            gate.await() +        } + +        viewModel.viewDetail("oc1") +        viewModel.receiveItems("oc1", mapOf("i1" to 10)) +        assertTrue(viewModel.uiState.value.receiving) + +        viewModel.receiveItems("oc1", mapOf("i1" to 10)) +        gate.complete(Unit) + +        val state = viewModel.uiState.first { it.success != null || it.error != null } +        assertEquals("Recepción registrada", state.success) +        assertFalse(state.receiving) +        coVerify(exactly = 1) { repository.receiveItems("oc1", "o1", mapOf("i1" to 10)) }      }  }
