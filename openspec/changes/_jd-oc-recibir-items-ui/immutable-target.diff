edTextChange = { value -> +                                receivedTextById = receivedTextById + (item.id to value) +                            }, +                        ) +                    } +                } + +                if (canReceive) { +                    Text( +                        "El stock y el costo se actualizan solo cuando la orden queda completamente recibida.", +                        style = MaterialTheme.typography.bodySmall, +                        color = MaterialTheme.colorScheme.onSurfaceVariant, +                    ) +                    TextButton( +                        onClick = { +                            val filled = ReceiveQuantities.fillPending( +                                items.map { ReceiveQuantities.Line(it.id, it.cantidad) }, +                            ) +                            receivedTextById = filled.mapValues { it.value.toString() } +                        }, +                        enabled = items.isNotEmpty(), +                    ) { +                        Text("Recibir todo lo pendiente") +                    } +                }              }          },          confirmButton = { -            if (oc.estado == "APROBADA" || oc.estado == "PARCIAL") { -                TextButton(onClick = { onDismiss() }) { -                    Text("Recibir ítems") +            if (canReceive) { +                TextButton( +                    onClick = { +                        val cantidadById = items.associate { it.id to it.cantidad } +                        val absolute = ReceiveQuantities.toAbsoluteMap(receivedTextById, cantidadById) +                        viewModel.receiveItems(oc.id, absolute) +                        onDismiss() +                    }, +                    enabled = items.isNotEmpty(), +                ) { +                    Text("Confirmar recepción")                  }              }          }, @@ -257,3 +331,33 @@ private fun OrdenCompraDetailDialog(          },      )  } + +@Composable +private fun OrdenCompraReceiveItemRow( +    item: OrdenCompraItem, +    receivedText: String, +    canReceive: Boolean, +    onReceivedTextChange: (String) -> Unit, +) { +    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) { +        Text( +            text = item.monturaId, +            style = MaterialTheme.typography.bodyMedium, +            fontWeight = FontWeight.Medium, +        ) +        Text( +            text = "Pedido: ${item.cantidad} · Ya recibido: ${item.recibido}", +            style = MaterialTheme.typography.bodySmall, +            color = MaterialTheme.colorScheme.onSurfaceVariant, +        ) +        if (canReceive) { +            OptoTextField( +                value = receivedText, +                onValueChange = onReceivedTextChange, +                label = "Recibido total", +                keyboardType = KeyboardType.Number, +                modifier = Modifier.fillMaxWidth(), +            ) +        } +    } +}
diff --git a/optoapp/src/main/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantities.kt b/optoapp/src/main/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantities.kt new file mode 100644 index 00000000..617cb312 --- /dev/null +++ b/optoapp/src/main/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantities.kt @@ -0,0 +1,29 @@ +package com.example.optoapp.ui.screens.ordenescompra + +object ReceiveQuantities { + +    data class Line(val id: String, val cantidad: Int) + +    fun clamp(value: Int, cantidad: Int): Int { +        val max = cantidad.coerceAtLeast(0) +        return value.coerceIn(0, max) +    } + +    fun fillPending(items: List<Line>): Map<String, Int> = +        items.associate { it.id to it.cantidad.coerceAtLeast(0) } + +    fun parseQuantity(raw: String, cantidad: Int): Int { +        val trimmed = raw.trim() +        if (trimmed.isEmpty()) return 0 +        val parsed = trimmed.toIntOrNull() ?: return 0 +        return clamp(parsed, cantidad) +    } + +    fun toAbsoluteMap( +        textById: Map<String, String>, +        cantidadById: Map<String, Int>, +    ): Map<String, Int> = +        cantidadById.mapValues { (id, cantidad) -> +            parseQuantity(textById[id].orEmpty(), cantidad) +        } +}
diff --git a/optoapp/src/test/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantitiesTest.kt b/optoapp/src/test/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantitiesTest.kt new file mode 100644 index 00000000..32d977d3 --- /dev/null +++ b/optoapp/src/test/java/com/example/optoapp/ui/screens/ordenescompra/ReceiveQuantitiesTest.kt @@ -0,0 +1,76 @@ +package com.example.optoapp.ui.screens.ordenescompra + +import org.junit.Assert.assertEquals +import org.junit.Test + +class ReceiveQuantitiesTest { + +    @Test +    fun clamp_keepsValueInsideZeroToCantidad() { +        assertEquals(0, ReceiveQuantities.clamp(-3, 10)) +        assertEquals(0, ReceiveQuantities.clamp(0, 10)) +        assertEquals(4, ReceiveQuantities.clamp(4, 10)) +        assertEquals(10, ReceiveQuantities.clamp(10, 10)) +        assertEquals(10, ReceiveQuantities.clamp(15, 10)) +    } + +    @Test +    fun clamp_zeroCantidadAlwaysZero() { +        assertEquals(0, ReceiveQuantities.clamp(5, 0)) +        assertEquals(0, ReceiveQuantities.clamp(-1, 0)) +    } + +    @Test +    fun fillPending_mapsEachIdToCantidad() { +        val items = listOf( +            ReceiveQuantities.Line("i1", 10), +            ReceiveQuantities.Line("i2", 5), +        ) +        assertEquals(mapOf("i1" to 10, "i2" to 5), ReceiveQuantities.fillPending(items)) +    } + +    @Test +    fun fillPending_emptyList_returnsEmptyMap() { +        assertEquals(emptyMap<String, Int>(), ReceiveQuantities.fillPending(emptyList())) +    } + +    @Test +    fun parseQuantity_parsesDigitsAndClamps() { +        assertEquals(4, ReceiveQuantities.parseQuantity("4", 10)) +        assertEquals(10, ReceiveQuantities.parseQuantity("99", 10)) +        assertEquals(0, ReceiveQuantities.parseQuantity("-2", 10)) +    } + +    @Test +    fun parseQuantity_blankOrInvalid_returnsZero() { +        assertEquals(0, ReceiveQuantities.parseQuantity("", 10)) +        assertEquals(0, ReceiveQuantities.parseQuantity("   ", 10)) +        assertEquals(0, ReceiveQuantities.parseQuantity("abc", 10)) +        assertEquals(0, ReceiveQuantities.parseQuantity("1.5", 10)) +    } + +    @Test +    fun toAbsoluteMap_buildsClampedMapFromEditableText() { +        val textById = mapOf( +            "i1" to "4", +            "i2" to "", +            "i3" to "99", +        ) +        val cantidadById = mapOf( +            "i1" to 10, +            "i2" to 5, +            "i3" to 8, +        ) +        assertEquals( +            mapOf("i1" to 4, "i2" to 0, "i3" to 8), +            ReceiveQuantities.toAbsoluteMap(textById, cantidadById), +        ) +    } + +    @Test +    fun toAbsoluteMap_skipsIdsWithoutCantidad() { +        val textById = mapOf("i1" to "3", "ghost" to "9") +        val cantidadById = mapOf("i1" to 10) +        assertEquals(mapOf("i1" to 3), ReceiveQuantities.toAbsoluteMap(textById, cantidadById)) +    } +}
